#!/bin/rc -b
wins=()
cons=()
server=irc.oftc.net
port=6697
tls=1
pass=()
srvpass=()
chans=()
username=$user
realname='<nil>'
nick=$username

while (~ $1 -*) {
	switch ($1) {
	case -c
		chans=`{echo $2 | sed 's/,/ /g'}
		shift
	case -n
		nick=$2
		shift
	case -p
		port=$2
		shift
	case -r
		realname=$2
		shift
	case -u
		username=$2
		shift
	case -U
		tls=0
	case -*
		echo 'usage: wircrc [-c chans] [-n nick] [-p port] [-r realname] [-u user] [-U] [server]' >[1=2]
		exit 'usage'	
	}
	shift
}
if(~ $#* 1)
	server=$1

bind '#|' /n/wircrc
bind '#|' /n/wircrc.w
rfork en

fn wmk {
	id=$1
	>/n/wircrc/data1 {
		@{
			rfork s
			d=/n/wircrc.$id
			p=`{cat /dev/ppid}
			mount $wsys $d 'new -scroll -pid '^$p || exit
			echo -n $id | tr -d \x0a >$d/label
			echo wnew $id $d $p
			if(! ~ $#* 1)
				echo cmsg $id $*(2-)
			<$d/cons {
				while(line=`{read}){
					~ $line '' || echo wtype $id $line
				}
			}
		}
		echo wclose $id
	}
	exit
}

fn etime {
	date -t | sed 's/-//g;s/^..(.*)T(..):(..).*/\1:\2\3/'
}

fn wio {
	t=`{etime}
	if(~ $1 $wins){
		d=wd$1
		d=$$d
		if(! ~ $2 $muted)
			@{echo $t $*(2-) | tee -a /tmp/irc.^$1 >$d/cons}
		if not
			@{echo $t $*(2-) | tee -a /tmp/irc.^$1 | sed 's/⇒ .*/⇒/'  >$d/cons}
	}
}

fn sio {
	d=$1
	if(~ $d *!*)
		d=`{echo $d | awk -F'!' '{print $1}'}
	if(~ $d $cons){
		d=cd$d
		d=$$d
		@{echo $*(2-) >$d/data}
		@{echo $*(2-) | sed -n 's/^PRIVMSG [^ ]+ :/'^`{etime}^' '^$nick^' ⇒ /p' >>/tmp/irc^.$1}
	}
}

fn wctl {
	if(~ $1 $wins){
		d=wd$1
		d=$$d
		shift
		@{echo $* >$d/wctl}
	}
}

fn hangup {
	if(~ $1 $cons){
		d=cpid$1
		d=$$d
		@{echo kill >/proc/$d/notepg}
	}
}

fn getkey {
	a=`{auth/userpasswd -n 'server='^$1^' service=irc user='^$nick >[2]/dev/null}
	if(~ $#a 2)
		pass=$a(2)
	a=`{auth/userpasswd -n 'server='^$1^' service=ircsrv user='^$nick >[2]/dev/null}
	if(~ $#a 2)
		srvpass=$a(2)
	a=()
}

fn dial {
	c=/n/wircrc.$1
	bind '#|' $c
	if(~ $2 1){
		tlsclient $1 <>$c/data1 >[1=0] &
		awk '/Chan/{ sub("data", "ctl", $2); print "keepalive 480000" >$2 }' \
			`{sed -n 's,.*(/net/tls/[0-9]+/)data,\1status,p' /proc/$apid/fd}
	}
	if not{
		aux/trampoline $1 <>$c/data1 >[1=0] &
	}
	<>$c/data >[1=0]{
		$*(3-) $c $apid
		exit
	}
}

fn irc {
	>[3]/n/wircrc/data1 {
		echo cnew $* >[1=3]
		tr -d '\x2\x8\xd\x1f' | @{
			while(line=`{read}){
				if(~ $line(1) PING){
					echo PONG $line(2-)
					echo cpong $1 >[1=3]
				}
				if not if(! ~ $line(2) JOIN || ! ~ $line(1) :$nick!*){
					line=`{echo $line | sed '
s/^:([^!]+)[^ ]+ PRIVMSG (#[^ ]+)[^:]+:(.*)/cmsg '$1'!\2 \1 \3/g;
s/^:([^!]+)[^ ]+ PRIVMSG :?([^ ]+)[^:]+:(.*)/cmsg '$1'!\1 \1 \3/g;
s/^:([^!]+)[^ ]+ NOTICE \*[^:]+:(.*)/cmsg '$1' \1 \2/g;
s/^:([^!]+)[^ ]+ NOTICE ([^ ]+)[^:]+:(.*)/cmsg '$1'!\1 \1 \3/g;
s/^:([^!]+)[^ ]+ (KICK) (#[^ ]+) ([^ ]+:?)(.*)/xmsg '$1'!\3 \2 \1 \4 \5/g;
s/^:([^!]+)[^ ]+ ([0-9]+)[^:]+:?(.*)/xmsg '$1' \2 \3/g;
s/^:([^!]+)[^ ]+ (MODE|TOPIC) (#[^ ]+) :?(.*)/xmsg '$1'!\3 \2 \4/g;
s/^:([^!]+)[^ ]+ (QUIT|NICK) :(.*)/xmsg '$1' \2 \1 \3/g;
s/^:([^!]+)[^ ]+ (PART) (#[^\ ]+).*/xmsg '$1'!\3 \2 \1/g;
s/^:([^!]+)[^ ]+ (JOIN) :?(#[^\ ]+).*/xmsg '$1' \2 \3 \1/g;
s/^:(.*) (PONG) [^ ]+[^:]+:(.*)/xmsg '$1' \2 \1 \3/g;
s/^:([^!]+)[^ ]+ ([A-Z]+) ?:?(.*)/xmsg '$1' \2 \1 \3/g;
s/^:([^!]+)[^ ]+ (.*)/xmsg '$1' \2/g;
'}
					~ $line '' || echo $line >[1=3]
				}
			}
		}
		echo cclose $1 >[1=3]
	}
}

fn shutdown {
	for(i in $cons)
		hangup $i
	for(i in $wins){
		d=wp$i
		d=$$d
		@{echo hangup >/proc/$d/notepg} &
	}
	{}>/n/wircrc/data
	echo shutdown 1 >/n/wircrc.w/data1
}

fn sighup {
	shutdown
}

fn sigint {
	shutdown
}

fn checkconn {
	for(i in $srvs){
		ti=last$i
		d=`{echo $1 - $$ti | pc}
		if(test $d -ge 480){
			echo wtype $i /r $i
			last$i=$1
		}
		if not if(test $d -ge 360){
			for(j in $wins){
				d=wd$i
				d=$$d
				@{echo scroll >$d/wctl}
			}
			echo wtype $i /p
		}
	}
}

fn watch {
	srvs=()
	ot=`{date -n}
	</n/wircrc.w/data >/n/wircrc/data1 {
		while(){
			a=`{alarm 90 read >[2]/dev/null}
			s=$status
			t=`{date -n}
			if(~ $s alarm* '' && ~ $#a 2){
				id=`{echo $a(2) | awk -F'!' '{print $1}'}
				switch($a(1)){
				case w* cclose
				case shutdown
					exit
				case hangup
					osrvs=srvs
					srvs=()
					for(i in $osrvs){
						if(! ~ $i $id)
							srvs=($srvs $i)
					}
				case *
					if(! ~ $id $srvs)
						srvs=($srvs $id)
					last$id=$t
				}
			}
			if not if(! ~ $s alarm* '')
				exit
			d=`{echo $t - $ot | pc}
			if(test $d -ge 30){
				checkconn $t
				ot=$t
			}
		}
	}
}

wmk $server &
dial tcp!$server!$port $tls irc $server &
watch &

</n/wircrc/data >[3]/n/wircrc.w/data1 {
	while(a=`{read}){
		echo $a(1-2) >[1=3]
		id=$a(2)
		switch($a(1)){
		case cnew
			cd$id=$a(3)
			cpid$id=$a(4)
			cons=($id $cons)
			getkey $id
			if(! ~ $#srvpass 0)
				sio $id PASS $srvpass
			sio $id USER $username foo bar :$realname
			sio $id NICK $nick
			if(! ~ $#pass 0)
				sio $id nickserv identify $pass
			pass=()
			srvpass=()
			for(i in $chans){
				if(~ $i $id!'#'*){
					if(! ~ $i $wins)
						wmk $i &
					sio $id JOIN `{echo $i | awk -F'!' '{print $2}'}
				}
			}
		case cclose
			d=cd$id
			$d=()
			oids=$cons
			cons=()
			for(i in $oids){
				if(! ~ $i $id)
					cons=($i $cons)
			}
			for(i in $wins){
				if(~ $i $id || ~ $i $id!*)
					wio $i HUNGUP $id
			}
		case wnew
			wd$id=$a(3)
			wp$id=$a(4)
			wins=($id $wins)
			x=wip$id
			$x=()
		case wclose
			d=wd$id
			p=wp$id
			unmount $$d
			$d=()
			$p=()
			oids=$wins
			wins=()
			for(i in $oids){
				if(! ~ $i $id)
					wins=($i $wins)
			}
			if(~ $id $chans){
				oids=$chans
				chans=()
				for(i in $oids){
					if(! ~ $i $id)
						chans=($i $chans)
				}
				sio $id PART `{echo $id | awk -F'!' '{print $2}'}
			}
		case xmsg
			if(~ $id $wins)
				wio $id $a(3-)
			if not {
				for(i in $wins){
					if(~ $i $id!*)
						wio $i $a(3-)
				}
			}
		case cmsg
			x=wip$id
			if(~ $id $wins)
				wio $id $a(3) '⇒' $a(4-)
			if not if(! ~ $#$x 0){
				{ sleep 1; echo $a >/n/wircrc/data1 } &
			}
			if not if(! ~ $id *!'#'*){
				$x=1
				wmk $id $a(3-) &
			}
		case wtype
			switch($a(3)){
			case /Q
				if(~ $a(4) $muted){
					om=$muted
					muted=()
					for(i in $om){
						if(! ~ $i $a(4))
							muted=($muted $i)
					}
					om=()
				}
				if not
					muted=($muted $a(4))
			case /x
				shutdown
			case /s
				server=$a(4)
				if(! ~ $server '' && ! ~ $server $cons){
					if(! ~ $server $wins)
						wmk $server &
					if(~ $a(5) port)
						port=$a(6)
					dial tcp!$server!$port $tls irc $server &
				}
			case /j /t
				target=$a(4)
				server=`{echo $id | awk -F'!' '{print $1}'}
				if(! ~ $target '' && ~ $server $cons){
					id=$server!$target
					if(~ $id $wins){
						wctl $id unhide
						wctl $id current
					}
					if not {
						wmk $id &
					}
					if(~ $a(3) /j && ~ $target '#'*){
						if(! ~ $id $chans){
							chans=($id $chans)
							sio $server JOIN $target
						}
					}
				}
			case /h
				if(~ $a(4) $cons)
					id=$a(4)
				echo hangup $id >[1=3]
				hangup `{echo $id | awk -F'!' '{print $1}'}
			case /r
				id=$a(4)
				if(! ~ $id ''){
					server=`{echo $id | awk -F'!' '{print $1}'}
					if(~ $id $cons){
						hangup $server
						oids=$cons
						cons=()
						for(i in $oids){
							if(! ~ $i $id)
								cons=($i $cons)
						}
					}
					if(! ~ $server $wins)
						wmk $server &
					if(! ~ $a(5) '')
						port=$a(5)
					dial tcp!$server!$port $tls irc $server &
				}
			case /n
				nick = $a(4)
				server=`{echo $id | awk -F'!' '{print $1}'}
				sio $server NICK $a(4)
			case /p
				server=`{echo $id | awk -F'!' '{print $1}'}
				sio $server PING $server
			case *
				target=`{echo $id | awk -F'!' '{print $2}'}
				if(~ $target '')
					sio $id $a(3-)
				if not {
					a=$a(3-)
					sio $id PRIVMSG $target ':'^$"a
				}
			}
		}
	}
}
shutdown
